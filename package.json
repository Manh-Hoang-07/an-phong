{
  "name": "an-phong",
  "version": "0.1.0",
  "private": true,
  "description": "Ẩn Phong - game nhập vai ninja 2D chơi trên web, tự lưu lên server",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "backup": "node --env-file-if-exists=.env server/tools/ops/backup.js",
    "giftcode": "node --env-file-if-exists=.env server/tools/ops/giftcode.js",
    "grant-skill": "node --env-file-if-exists=.env server/tools/ops/grant-skill.js",
    "user": "node --env-file-if-exists=.env server/tools/ops/user.js",
    "check:mobs": "node server/tools/check/check-mob-sprites.js",
    "check:maps": "node server/tools/check/check-maps.js",
    "check:mob-hp": "node server/tools/check/check-mob-hp.js",
    "check:mob-hp-live": "node server/tools/check/check-mob-hp-live.js",
    "check:mob-death": "node server/tools/check/check-mob-death.js",
    "mobs:state": "node --env-file-if-exists=.env server/tools/check/peek-mob-state.js",
    "mobs:reset": "node --env-file-if-exists=.env server/tools/ops/reset-mobs.js",
    "check:player-pos": "node server/tools/check/check-player-pos.js",
    "check:awaken-regen": "node server/tools/check/check-awaken-regen.js",
    "check:skill-fx": "node server/tools/check/audit-skill-fx.js",
    "check:skill-books": "node server/tools/check/check-skill-books.js",
    "check:buff-stacking": "node server/tools/check/check-buff-stacking.js",
    "check:player-pos-live": "node --env-file-if-exists=.env server/tools/check/check-player-pos-live.js",
    "check:player-pos-restart": "node --env-file-if-exists=.env server/tools/check/check-player-pos-restart.js",
    "player:pos": "node --env-file-if-exists=.env server/tools/check/peek-player-pos.js",
    "player:fix-arrive": "node --env-file-if-exists=.env server/tools/ops/fix-arrive.js",
    "check:special-gear": "node server/tools/check/check-special-gear.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.2.5",
    "pg": "^8.16.3",
    "phaser": "3.90.0",
    "ws": "^8.23.0"
  }
}
