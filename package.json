{
  "name": "an-phong",
  "version": "0.1.0",
  "private": true,
  "description": "Ẩn Phong - game nhập vai ninja 2D chơi trên web, tự lưu lên server",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "backup": "node --env-file-if-exists=.env server/backup.js",
    "giftcode": "node --env-file-if-exists=.env server/tools/giftcode.js",
    "check:mobs": "node server/tools/check-mob-sprites.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.2.5",
    "pg": "^8.16.3",
    "phaser": "3.90.0"
  }
}
